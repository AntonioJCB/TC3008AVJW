# Supabase Dashboard > Connect: Project URL.
# Settings > API Keys > Legacy API Keys: service_role (JWT que comienza con eyJ).
# Esta versión del backend todavía no acepta sb_secret_. Nunca copies esta llave al frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-jwt

# Opcional: Dashboard > Connect > cadena PostgreSQL. Solo GET /api/v1/health/db.
# Deja esta variable sin definir si no usarás esa ruta.
# BAXTERSEC_DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/baxtersec

# Censys Platform > API Access > Create New Token (PAT). Sin él, Censys queda fallido.
# Free admite lookup por IP, sujeto a créditos. No usa Legacy API ID/Secret.
# theHarvester es un ejecutable local; SpiderFoot es un servicio local, no llaves.
CENSYS_PAT=replace-with-censys-pat
# Opcional: dejar vacío para Free; no usar el ID de organización de Supabase.
CENSYS_ORGANIZATION_ID=
# JSON por dominio: solo IPs propias/autorizadas para atribuir servicios y CVE.
# Ejemplo de formato (no usar IPs documentales para pruebas reales):
# CENSYS_AUTHORIZED_IPS='{"mi-dominio.com":["203.0.113.10"]}'
# Vacío: guarda inventario DNS/crudos; descarta servicios de IP compartida.
CENSYS_AUTHORIZED_IPS=
THEHARVESTER_BIN=theHarvester
THEHARVESTER_SOURCES=certspotter,hackertarget
SPIDERFOOT_URL=http://127.0.0.1:5001
# Módulos pasivos y sin API usados por el backend; evita el grupo Passive completo.
SPIDERFOOT_MODULES=sfp_dnsresolve,sfp_dnsraw,sfp_robtex,sfp_crobat_api

# Límites de tiempo y reintentos.
REQUEST_TIMEOUT_SECONDS=30
# crt.sh suele tardar más que las demás APIs. Este límite solo aplica a crt.sh.
CRTSH_TIMEOUT_SECONDS=60
PROCESS_TIMEOUT_SECONDS=900
SPIDERFOOT_TIMEOUT_SECONDS=1800
SPIDERFOOT_POLL_SECONDS=3
SCAN_TIMEOUT_SECONDS=2100
CRTSH_RETRIES=3
CENSYS_MAX_IPS=10
CENSYS_PAUSE_SECONDS=1.1

# Orígenes web permitidos. Configura los dominios reales al desplegar.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Asistente de IA: https://console.anthropic.com/ > API Keys. Sin ella, el asistente queda deshabilitado.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
ASSISTANT_MAX_TOKENS=1000