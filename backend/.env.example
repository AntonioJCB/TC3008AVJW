# --- Supabase (solo servidor; NUNCA en el frontend ni en el repositorio) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret-key

# --- Fuentes OSINT ---
# Sin llave de Shodan, esa fuente falla con un mensaje claro y el escaneo queda 'incompleto'.
SHODAN_API_KEY=replace-with-shodan-api-key
THEHARVESTER_BIN=theHarvester
THEHARVESTER_SOURCES=crtsh,certspotter
SPIDERFOOT_URL=http://127.0.0.1:5001

# --- Tiempos y reintentos ---
REQUEST_TIMEOUT_SECONDS=30
PROCESS_TIMEOUT_SECONDS=900
SPIDERFOOT_TIMEOUT_SECONDS=1800
SPIDERFOOT_POLL_SECONDS=3
# Tiempo máximo por fuente; debe ser mayor que SPIDERFOOT_TIMEOUT_SECONDS
SCAN_TIMEOUT_SECONDS=2100
CRTSH_RETRIES=3
SHODAN_MAX_IPS=10
SHODAN_PAUSE_SECONDS=1.1

# --- CORS: dónde corre el frontend (Next.js usa el 3000, Vite el 5173) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
