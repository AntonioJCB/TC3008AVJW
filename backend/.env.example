# Supabase Dashboard > Connect: Project URL.
# Settings > API Keys > Legacy API Keys: service_role (JWT que comienza con eyJ).
# Esta versión del backend todavía no acepta sb_secret_. Nunca copies esta llave al frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-jwt

# Opcional: Dashboard > Connect > cadena PostgreSQL. Solo GET /api/v1/health/db.
# Deja esta variable sin definir si no usarás esa ruta.
# BAXTERSEC_DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/baxtersec

# Opcional: https://account.shodan.io/ > API Key. Sin ella, Shodan queda fallido.
# theHarvester es un ejecutable local; SpiderFoot es un servicio local, no llaves.
SHODAN_API_KEY=replace-with-shodan-api-key
THEHARVESTER_BIN=theHarvester
THEHARVESTER_SOURCES=crtsh,certspotter
SPIDERFOOT_URL=http://127.0.0.1:5001

# Límites de tiempo y reintentos.
REQUEST_TIMEOUT_SECONDS=30
# crt.sh suele tardar más que las demás APIs. Este límite solo aplica a crt.sh.
CRTSH_TIMEOUT_SECONDS=60
PROCESS_TIMEOUT_SECONDS=900
SPIDERFOOT_TIMEOUT_SECONDS=1800
SPIDERFOOT_POLL_SECONDS=3
SCAN_TIMEOUT_SECONDS=2100
CRTSH_RETRIES=3
SHODAN_MAX_IPS=10
SHODAN_PAUSE_SECONDS=1.1

# Orígenes web permitidos. Configura los dominios reales al desplegar.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
