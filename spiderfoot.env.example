# Copia este archivo como spiderfoot.env solo al habilitar proveedores opcionales.
# InternetDB: disabled, noncommercial o licensed. No declares una modalidad que
# no corresponda al uso real de la organización.
SPIDERFOOT_INTERNETDB_USE=disabled

# Opcional. Sin clave se usa búsqueda pública con la cuota y ventana indicadas
# por urlscan en search_date_limit_days. No habilita envíos de escaneos.
SPIDERFOOT_URLSCAN_API_KEY=

# Common Crawl no requiere API key. Estos límites consultan únicamente índices
# públicos y nunca descargan archivos WARC.
SPIDERFOOT_COMMONCRAWL_INDEXES=2
SPIDERFOOT_COMMONCRAWL_MAX_RESULTS=50

# Opcional: bundle PEM de la CA institucional que inspecciona HTTPS. El archivo
# se monta desde deploy/spiderfoot-ca/ y nunca debe subirse al repositorio.
# No sustituir por verify=false.
SPIDERFOOT_CA_BUNDLE=
